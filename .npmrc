; electron-vite@2 requires vite ^4||^5, vitest@4 requires vite ^6||^7||^8.
; No single vite version satisfies both, so npm's peer resolver rejects the
; tree even though it installs and runs correctly (452 tests + build pass on
; vite 5). `npm install` locally papered over this; `npm ci` enforces peers
; strictly and failed on the first CI run.
;
; This pins CI to "install exactly what package-lock.json says" rather than
; re-resolving peers. The lockfile is complete and in sync, so the install is
; still fully reproducible.
;
; PROPER FIX (needs an npm-capable shell): bump electron-vite to v3+, which
; supports vite 6/7, then upgrade vite and drop this file.
legacy-peer-deps=true
