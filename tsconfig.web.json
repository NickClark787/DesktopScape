{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/renderer/*"],
      "@engine/*": ["src/engine/*"],
      "@sim/*": ["src/sim/*"],
      "@shared/*": ["src/shared/*"],
      "@data/*": ["resources/data/*"]
    }
  },
  "include": [
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
    "src/engine/**/*.ts",
    "src/sim/**/*.ts",
    "src/shared/**/*.ts",
    "resources/data/*.json"
  ]
}
